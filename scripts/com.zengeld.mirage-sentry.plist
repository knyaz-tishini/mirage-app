<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zengeld.mirage-sentry</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dev/bin/mirage-sentry</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/dev/Library/Logs/mirage-sentry.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dev/Library/Logs/mirage-sentry.stderr.log</string>
</dict>
</plist>
