[Unit]
Description=Mirage Sentry — passive slave-mode agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mirage-sentry
Restart=always
RestartSec=10
User=root
Group=root
Environment=RUST_LOG=info
# state_dir defaults to /root/.local/share/mirage when running as root:
#   /root/.local/share/mirage/sentry-id.txt  — stable per-host sentry_id
#   /root/.local/share/mirage/sentry-state.json — per-LM client_id cache

[Install]
WantedBy=multi-user.target
